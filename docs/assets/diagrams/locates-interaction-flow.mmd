flowchart LR
  A["启动枣寻 LocateS"] --> B["初始化能力"]
  B --> B1["RelationalStore 数据库"]
  B --> B2["CalendarKit 日历权限与本地日历"]
  B --> B3["背景配置 AppStorage"]
  B --> C["沉浸式首页 HdsTabs"]

  C --> D["物品 Tab"]
  C --> E["空间 Tab"]
  C --> F["事件 Tab"]
  C --> G["我的 Tab"]
  C --> Q["悬浮迷你加号"]

  Q --> Q1["长按触发当前 Tab 快速添加"]
  Q1 --> D2
  Q1 --> E1
  Q1 --> F2

  D --> D1["搜索物品名称"]
  D --> D5["分类筛选与分类管理"]
  D --> D2["添加物品半模态"]
  D2 --> D3["写入 item 表"]
  D --> D4["物品详情"]
  D4 --> D6["修改分类"]
  D4 --> D7["分配到空间分区"]
  D4 --> D8["删除物品并清理事件关联"]

  E --> E1["创建空间"]
  E1 --> E2["拍照或相册选择空间图片"]
  E2 --> E3["写入 space 表 level=1"]
  E --> E4["进入空间图片视图"]
  E4 --> E5["拖拽平移图片"]
  E4 --> E6["点击图片放置标记点"]
  E6 --> E7["创建分区 level=2"]
  E7 --> E8["彩色标记点叠加在图片上"]
  E8 --> E9["进入分区物品列表"]
  E9 --> E10["关联未分配物品"]
  E4 --> E11["双击进入全屏预览"]
  E11 --> E12["全屏点击新增分区或点标记跳转分区"]
  E4 --> E13["替换图片"]
  E13 --> E14["清理旧分区并将相关物品置为未分配"]

  F --> F1["日历视图与事件列表"]
  F --> F2["创建事件半模态"]
  F2 --> F3["选择日期和时间"]
  F2 --> F4["搜索并勾选关联物品"]
  F4 --> F5["写入 event 与 event_item"]
  F5 --> F6["同步写入 CalendarKit"]
  F --> F7["事件详情"]
  F7 --> F8["清单勾选 prepared"]
  F8 --> F9["乐观更新进度条"]
  F7 --> F10["修改物品或时间"]
  F10 --> F11["改期后重建日历事件"]
  F7 --> F12["分享清单文本"]
  F7 --> F13["标记完成或删除事件"]

  G --> G1["物品总数"]
  G --> G2["分类统计"]
  G --> G3["事件统计"]
  G --> G4["进行中提醒"]
  G --> G5["背景设置"]
  G5 --> G6["渐变 / 预设图片 / 自定义相册背景"]
  G6 --> B3

  D3 --> R["AppStorage 刷新令牌"]
  D6 --> R
  D7 --> R
  D8 --> R
  E10 --> R
  E14 --> R
  F5 --> R
  F8 --> R
  F10 --> R
  F13 --> R
  R --> D
  R --> E
  R --> F
  R --> G

  B1 --> T["数据表"]
  T --> T1["item"]
  T --> T2["space: image, markerX, markerY, markerColor"]
  T --> T3["event"]
  T --> T4["event_item: prepared 清单状态"]

